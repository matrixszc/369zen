---
import { getPublishedPosts } from "../lib/posts.ts";

const posts = await getPublishedPosts();
const recent = posts.slice(0, 5);
---

<section class="max-w-5xl mx-auto px-6 py-20">
  <h2 class="text-3xl font-bold">
    最新文章
  </h2>

  <p class="mt-3 text-ink-2">
    最近的思考与记录
  </p>

  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {recent.map((post) => (
      <a
        href={`/blog/${post.id}/`}
        class="rounded-2xl border border-line p-6 hover:bg-surface-2 transition block"
      >
        <h3 class="text-xl font-semibold">
          {post.data.title}
        </h3>

        <p class="mt-2 text-ink-2 line-clamp-2">
          {post.data.description}
        </p>

        <p class="mt-3 text-sm text-ink-muted">
          {post.data.pubDate.toLocaleDateString("zh-CN", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </p>
      </a>
    ))}
  </div>

  {posts.length > 5 && (
    <div class="mt-8 text-center">
      <a
        href="/blog"
        class="rounded-full border border-line px-6 py-3 hover:bg-surface-2 transition inline-block"
      >
        查看全部文章 →
      </a>
    </div>
  )}
</section>
