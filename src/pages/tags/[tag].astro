---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts.ts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tagSet = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      tagSet.add(tag);
    }
  }
  return [...tagSet].map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const posts = await getPublishedPosts();
const tagged = posts.filter((p) => (p.data.tags ?? []).includes(tag));
---

<BaseLayout title={`#${tag} | 数字禅`} description={`标签「${tag}」下的文章`}>
  <main class="max-w-5xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold">
      <span class="text-ink-muted">#</span>{tag}
    </h1>

    <p class="mt-3 text-ink-2">
      {tagged.length} 篇文章
    </p>

    <ul class="mt-10 space-y-6">
      {tagged.map((post) => (
        <li class="rounded-xl border border-line p-6">
          <h2 class="text-2xl font-semibold">
            <a href={`/blog/${post.id}/`} class="hover:underline">
              {post.data.title}
            </a>
          </h2>
          <p class="mt-2 text-ink-2">
            {post.data.description}
          </p>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
