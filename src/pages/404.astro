---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="页面不存在 | 369 Zen"
  description="这个页面不存在，也许它还在数字禅的某个角落等待被写下。"
>
  <main class="min-h-[60vh] flex items-center justify-center text-center px-6">
    <div>
      <h1 class="text-6xl font-bold text-ink-muted">
        404
      </h1>

      <p class="mt-6 text-lg text-ink-2 max-w-md mx-auto leading-relaxed">
        这个页面不存在。
        <br />
        也许它还在数字禅的某个角落，等待被写下。
      </p>

      <a
        href="/"
        class="mt-10 inline-block rounded-full bg-ink text-surface px-6 py-3 hover:opacity-80 transition"
      >
        回到首页
      </a>
    </div>
  </main>
</BaseLayout>
