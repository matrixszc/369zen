---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts.ts";

const posts = await getPublishedPosts();

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
---

<BaseLayout title="博客 | 数字禅">
  <main class="max-w-5xl mx-auto px-6 py-16">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-bold">博客</h1>
      <p class="mt-3 text-lg text-ink-2">
        记录思考、实践与成长的片段。
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="mt-12 rounded-2xl border border-line bg-surface-2 p-10 text-center">
        <p class="text-lg font-medium">还没有发布任何文章</p>
        <p class="mt-2 text-ink-2">
          内容整理后会在这里陆续展示。
        </p>
      </div>
    ) : (
      <ul class="mt-10 space-y-6">
        {posts.map((post) => (
          <li class="rounded-2xl border border-line p-6 transition hover:bg-surface-2">
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
              <div class="flex-1">
                <h2 class="text-2xl font-semibold">
                  <a href={`/blog/${post.id}/`} class="hover:underline">
                    {post.data.title}
                  </a>
                </h2>

                <p class="mt-3 text-ink-2 leading-relaxed">
                  {post.data.description ?? "暂无摘要。"}
                </p>
              </div>

              <div class="md:text-right">
                <p class="text-sm text-ink-muted">
                  {formatDate(post.data.pubDate)}
                </p>

                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2 md:justify-end">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <a
                        href={`/tags/${encodeURIComponent(tag)}/`}
                        class="rounded-full border border-line px-3 py-1 text-sm text-ink-2 transition hover:bg-surface"
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>